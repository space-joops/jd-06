# 아스트로펫 환경 변수 (빌드 시 인라인됨). 값을 바꾸려면 .env.local 등에 복사해 설정.
# NEXT_PUBLIC_* 는 클라이언트 번들에 포함된다.

# 육성 단계 우주젤리(밥 주기) 쿨다운(ms). 기본 20000
NEXT_PUBLIC_FEED_COOLDOWN_MS=20000

# 함께 수거하기(우주유영) 게임의 초기 분사 가스량(=탱크 최대). 양수. 기본 70
# 낮추면 게임이 짧고 어려워지고, 높이면 여유로워진다.
NEXT_PUBLIC_GAS_MAX=70

# 배포 도메인(절대 URL). OG 이미지 절대경로(크롤러 프리뷰)에 사용.
# 미설정 시 https://jd-06.vercel.app 로 대체되며, 인앱 공유 버튼은 런타임 origin을 쓴다.
NEXT_PUBLIC_SITE_URL=https://jd-06.vercel.app

# 카카오톡 공유용 Kakao JavaScript 키(카카오 개발자). 없으면 카카오 버튼은
# 네이티브 공유 시트/링크 복사로 폴백한다.
NEXT_PUBLIC_KAKAO_JS_KEY=
